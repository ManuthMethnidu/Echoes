# Neon Serverless Postgres Connection String (Copy from Neon Console or Vercel Postgres integration)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/monochrome_db?sslmode=require

# Secret for signing JWT tokens (Generate with `openssl rand -hex 32`)
AUTH_SECRET=generate_a_random_32_byte_hex_secret_here

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
