# Neon Serverless Postgres Connection String (neondb with pooled connections)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-small-mouse-a11jp1gr-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-small-mouse-a11jp1gr-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon Better Auth endpoints
NEON_AUTH_BASE_URL=https://ep-small-mouse-a11jp1gr.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-small-mouse-a11jp1gr.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Secret for signing JWT tokens and pairing cookies (minimum 32 characters)
AUTH_SECRET=your_32_character_random_secret_string_here
JWT_SECRET=your_32_character_random_secret_string_here

# Google OAuth 2.0 Credentials (for Sign-In and YouTube playlist imports)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Echoes Connect Realtime Worker (Cloudflare Edge WebSocket)
ECHOS_CONNECT_WS_URL=wss://echoes-connect-worker.methnidumanuth.workers.dev/ws
